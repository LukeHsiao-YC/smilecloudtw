---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
  const guidelines = await getCollection('guideline' as any) as any[];
  
  // 【終極防呆防護網】
  // 如果系統真的抓不到檔案，我們強制生成一個警告頁，避免死當出現 404
  if (!guidelines || guidelines.length === 0) {
     return [{
       params: { id: 'fgid' },
       props: { entry: { id: 'fgid', data: { title: '系統找不到文章' }, _isMock: true } }
     }];
  }
  
  return guidelines.map((entry: any) => {
    // 同時支援新舊版的 ID 抓取，並強制轉小寫
    const rawId = entry.slug || entry.id;
    const safeId = rawId.toLowerCase().replace(/\.mdx?$/, '');
    
    return {
      params: { id: safeId },
      props: { entry },
    };
  });
}

const { entry } = Astro.props as any;

// 如果是真實文章，才去執行文字轉換
let Content;
if (!entry._isMock) {
    const rendered = await render(entry);
    Content = rendered.Content;
}
---

<Layout title={`${entry.data?.title || '臨床指引'} | Smilecloud 微笑雲朵`}>
  <Navbar />

  <main class="pt-24 pb-32 bg-slate-50 min-h-screen">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="mb-8">
        <a href="/" class="text-sky-600 font-bold hover:text-sky-700 transition-colors flex items-center gap-2 inline-flex">
          <i data-lucide="arrow-left" class="w-4 h-4"></i> 返回首頁
        </a>
      </div>

      <article class="bg-white rounded-[2rem] p-8 md:p-12 shadow-sm border border-slate-100 relative overflow-hidden">
        
        <div class="border-b border-slate-100 pb-8 mb-8">
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-emerald-50 text-emerald-700 font-bold text-sm mb-4">
            <i data-lucide="stethoscope" class="w-4 h-4"></i>
            醫師臨床指引
          </div>
          <h1 class="text-3xl md:text-4xl font-extrabold text-slate-800 leading-tight">
            {entry.data?.title || '未命名指引'}
          </h1>
        </div>

        <div class="prose prose-slate prose-sky max-w-none prose-headings:font-bold prose-a:text-sky-600">
          {entry._isMock ? (
            <div class="p-6 bg-rose-50 border-2 border-rose-200 rounded-xl text-rose-700 font-bold text-lg shadow-sm">
              🚨 警告：網頁有成功生出來，但是系統抓不到 src/content/guideline/ 裡面的 markdown 檔案！<br/><br/>
              這代表 404 問題解決了，但 FGID.md 檔案本身可能沒有被 GitHub 收錄進去。請回到 VS Code 左側的原始檔控制，檢查是否漏打勾了！
            </div>
          ) : (
            <Content />
          )}
        </div>
        
      </article>
    </div>
  </main>

  <Footer />

  <script is:inline>
    if (window.lucide) {
      window.lucide.createIcons();
    }
  </script>
</Layout>