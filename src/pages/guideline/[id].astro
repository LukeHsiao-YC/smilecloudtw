---
// @ts-nocheck
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
  // 【終極殺手鐧修正版】改用 import.meta.glob，這是系統底層合法允許的抓取方式
  const matches = import.meta.glob('../../content/guideline/*.md', { eager: true });
  const files = Object.entries(matches);
  
  if (!files || files.length === 0) {
     return [{
       params: { id: 'fapds' },
       props: { isMock: true, title: '系統找不到文章' }
     }];
  }
  
  return files.map(([filepath, fileModule]) => {
    // 從檔案的路徑 (例如 '../../content/guideline/fapds.md') 把檔名切出來當網址
    const filename = filepath.split('/').pop().replace(/\.md$/, '').toLowerCase();
    
    return {
      params: { id: filename },
      props: { 
        isMock: false, 
        Content: fileModule.default, // Markdown 轉換後的內容會放在 default 裡面
        title: fileModule.frontmatter?.title // 讀取你設定的 title
      },
    };
  });
}

// 接收抓出來的資料
const { isMock, Content, title } = Astro.props;
---

<Layout title={`${title || '臨床指引'} | Smilecloud 微笑雲朵`}>
  <Navbar />

  <main class="pt-24 pb-32 bg-slate-50 min-h-screen">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="mb-8">
        <a href="/" class="text-sky-600 font-bold hover:text-sky-700 transition-colors flex items-center gap-2 inline-flex">
          <i data-lucide="arrow-left" class="w-4 h-4"></i> 返回首頁
        </a>
      </div>

      <article class="bg-white rounded-[2rem] p-8 md:p-12 shadow-sm border border-slate-100 relative overflow-hidden">
        
        <div class="border-b border-slate-100 pb-8 mb-8">
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-emerald-50 text-emerald-700 font-bold text-sm mb-4">
            <i data-lucide="stethoscope" class="w-4 h-4"></i>
            醫師臨床指引
          </div>
          <h1 class="text-3xl md:text-4xl font-extrabold text-slate-800 leading-tight">
            {title || '未命名指引'}
          </h1>
        </div>

        <div class="prose prose-slate prose-sky max-w-none prose-headings:font-bold prose-a:text-sky-600">
          {isMock ? (
            <div class="p-6 bg-rose-50 border-2 border-rose-200 rounded-xl text-rose-700 font-bold text-lg shadow-sm">
              🚨 警告：網頁生出來了，但底層指令還是抓不到檔案！<br/><br/>
              如果看到這段字，請確認檔名是否真的是 .md 結尾。
            </div>
          ) : (
            <Content />
          )}
        </div>
        
      </article>
    </div>
  </main>

  <Footer />

  <script is:inline>
    if (window.lucide) {
      window.lucide.createIcons();
    }

    // 幫 Markdown 的表格加一層可以左右滑動的外套，對手機版超友善
    document.querySelectorAll('.prose table').forEach(table => {
      const wrapper = document.createElement('div');
      wrapper.className = 'table-wrapper overflow-x-auto my-8 rounded-xl shadow-sm border border-slate-200';
      table.parentNode.insertBefore(wrapper, table);
      wrapper.appendChild(table);
      table.style.margin = '0'; // 清除原本預設的邊距
    });
  </script>
</Layout>

<style is:global>
  /* 這裡負責把陽春的 Markdown 表格變漂亮 */
  .prose table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
  }
  .prose thead {
    background-color: #f0f9ff; /* 淡淡的藍色當作標題底色 */
    border-bottom: 2px solid #bae6fd;
  }
  .prose th {
    color: #0369a1;
    font-weight: 700;
    padding: 1rem;
    white-space: nowrap; /* 讓標題盡量不要斷行 */
  }
  .prose tbody tr {
    border-bottom: 1px solid #f1f5f9;
    transition: background-color 0.2s ease;
  }
  .prose tbody tr:hover {
    background-color: #f8fafc; /* 滑鼠移過去會有淡淡的底色提示 */
  }
  .prose td {
    padding: 1rem;
    color: #475569;
    vertical-align: top;
    line-height: 1.6;
  }
  /* 讓表格裡的強調文字顏色更清楚 */
  .prose td strong {
    color: #0c4a6e;
  }
</style>