---
// @ts-nocheck
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
  // 繞過系統的收集器，直接從資料夾把 md 檔案硬抓出來
  const files = await Astro.glob('../../content/guideline/*.md');
  
  if (!files || files.length === 0) {
     return [{
       params: { id: 'fapds' },
       props: { isMock: true, title: '系統找不到文章' }
     }];
  }
  
  return files.map((file) => {
    // 從檔案的絕對路徑中，把最後面的檔名切出來當作網址 (例如 fapds)
    const filename = file.file.split('/').pop().replace(/\.md$/, '').toLowerCase();
    
    return {
      params: { id: filename },
      props: { 
        isMock: false, 
        Content: file.Content, // Astro.glob 會直接幫我們轉換好內文
        title: file.frontmatter.title // 直接讀取你寫的 title
      },
    };
  });
}

// 接收抓出來的資料
const { isMock, Content, title } = Astro.props;
---

<Layout title={`${title || '臨床指引'} | Smilecloud 微笑雲朵`}>
  <Navbar />

  <main class="pt-24 pb-32 bg-slate-50 min-h-screen">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="mb-8">
        <a href="/" class="text-sky-600 font-bold hover:text-sky-700 transition-colors flex items-center gap-2 inline-flex">
          <i data-lucide="arrow-left" class="w-4 h-4"></i> 返回首頁
        </a>
      </div>

      <article class="bg-white rounded-[2rem] p-8 md:p-12 shadow-sm border border-slate-100 relative overflow-hidden">
        
        <div class="border-b border-slate-100 pb-8 mb-8">
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-emerald-50 text-emerald-700 font-bold text-sm mb-4">
            <i data-lucide="stethoscope" class="w-4 h-4"></i>
            醫師臨床指引
          </div>
          <h1 class="text-3xl md:text-4xl font-extrabold text-slate-800 leading-tight">
            {title || '未命名指引'}
          </h1>
        </div>

        <div class="prose prose-slate prose-sky max-w-none prose-headings:font-bold prose-a:text-sky-600">
          {isMock ? (
            <div class="p-6 bg-rose-50 border-2 border-rose-200 rounded-xl text-rose-700 font-bold text-lg shadow-sm">
              🚨 警告：網頁生出來了，但底層指令還是抓不到檔案！<br/><br/>
              如果看到這段字，請確認檔名是否真的是 .md 結尾。
            </div>
          ) : (
            <Content />
          )}
        </div>
        
      </article>
    </div>
  </main>

  <Footer />

  <script is:inline>
    if (window.lucide) {
      window.lucide.createIcons();
    }
  </script>
</Layout>